{
  "name": "@plantquest/model-vue",
  "version": "1.0.0-alpha.1",
  "description": "PlantQuest Model Vue 3 Components - Modern Vue 3 component library",
  "type": "module",
  "main": "./dist/vxg.cjs.js",
  "module": "./dist/vxg.es.js",
  "exports": {
    ".": {
      "import": "./dist/vxg.es.js",
      "require": "./dist/vxg.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/style.css": "./dist/vxg.css"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .js,.vue,.ts"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vue-tsc": "^1.8.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "jsdom": "^23.0.0",
    "happy-dom": "^12.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/plantquest/model-vue-2",
    "directory": "packages/model-vue"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "plantquest",
    "vxg"
  ],
  "author": "PlantQuest",
  "license": "MIT"
}
